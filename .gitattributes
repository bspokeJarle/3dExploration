* text=auto

# Keep Windows/.NET source files consistent in the working tree.
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.xaml text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

# Binary assets must never be line-ending normalized.
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.dll binary
*.exe binary
